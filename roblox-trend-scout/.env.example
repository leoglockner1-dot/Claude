# Copy this file to ".env" (setup.sh does it for you) and paste your keys after the = sign.

# Required for the AI recommendation. Get one at https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=

# Optional but recommended: YouTube Data API v3 key (free).
# https://console.cloud.google.com/ -> create project -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Advanced settings (you can leave these alone)
TRENDSCOUT_MODEL=claude-opus-5-5
TRENDSCOUT_EFFORT=high
PORT=8765
# Minimum hours between YouTube / Reddit checks (protects free quotas)
YOUTUBE_MIN_HOURS=12
REDDIT_MIN_HOURS=6

# Mac notifications after each collection: "on" or "off"
NOTIFICATIONS=on
# Alert when a niche's leading game grows this much vs yesterday (0.5 = +50%)
NOTIFY_JUMP=0.5
